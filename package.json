{
  "name": "moscow-mobile",
  "version": "0.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:ios": "expo export --platform ios --output-dir dist-ios",
    "build:android": "expo export --platform android --output-dir dist-android",
    "serve:web": "SERVE_WEB_DIST=1 node --experimental-strip-types scripts/live_city_publication_server.mjs",
    "typecheck": "tsc --noEmit",
    "test:model-performance": "node scripts/check_romanov_model_performance.mjs",
    "test:e2e-contract": "node scripts/run_contract_tests.mjs",
    "test:e2e-web": "playwright test tests/web.e2e.spec.ts tests/resume.e2e.spec.ts tests/touristPlanner.e2e.spec.ts tests/walkCompanion.e2e.spec.ts tests/nearby.e2e.spec.ts tests/pilotAnalyticsReport.e2e.spec.ts tests/personalTrip.e2e.spec.ts --project=chromium",
    "pilot:cohort": "node --experimental-strip-types scripts/aggregate_pilot_reports.mjs",
    "pilot:study": "node --experimental-strip-types scripts/build_pilot_study_report.mjs",
    "government:readiness": "node --experimental-strip-types scripts/report_government_delivery_readiness.mjs",
    "government:application-readiness": "node --experimental-strip-types scripts/report_moscow_pilot_application_readiness.mjs",
    "report:glb": "node scripts/report_glb_asset.mjs",
    "validate:oec-model-submission": "node --experimental-strip-types scripts/validate_old_english_court_submission.mjs",
    "validate:romanov-p0-evidence": "node --experimental-strip-types scripts/validate_romanov_p0_evidence.mjs",
    "provider:yclients-receiver": "node --experimental-strip-types scripts/yclients_webhook_receiver.mjs",
    "integration:status": "node --experimental-strip-types scripts/report_integration_master_plan.mjs",
    "integration:validate-phase0": "node --experimental-strip-types scripts/validate_phase0_evidence_manifest.mjs",
    "provider:proof-status": "node --experimental-strip-types scripts/report_provider_proof_status.mjs",
    "routing:valhalla-smoke": "node --experimental-strip-types scripts/valhalla_route_smoke.mjs",
    "live:tretyakov-smoke": "node --experimental-strip-types scripts/tretyakov_live_city_smoke.mjs",
    "live:tretyakov-programme-smoke": "node --experimental-strip-types scripts/tretyakov_programme_smoke.mjs",
    "live:refresh-runtime": "node --experimental-strip-types scripts/live_city_refresh_runtime.mjs",
    "live:publication-server": "node --experimental-strip-types scripts/live_city_publication_server.mjs",
    "live:publish-current": "node --experimental-strip-types scripts/publish_live_city_snapshot.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/slider": "5.2.0",
    "@reactvision/react-viro": "2.58.1",
    "expo": "~57.0.0",
    "expo-asset": "57.0.17",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.17",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-yandex-mapkit": "2.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.4",
    "three": "0.183.0",
    "@sentry/react-native": "8.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.0",
    "serve": "^14.2.4",
    "typescript": "~6.0.3"
  }
}
