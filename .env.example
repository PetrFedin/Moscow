# Client-side MapKit key. Restrict it in Yandex Developer Dashboard by app identifiers/signatures.
EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY=

# First verified Romanov Chambers GLB. Can point to a CDN during development.
EXPO_PUBLIC_ROMANOV_GLB_URL=

# Show field calibration controls in non-development builds used for on-site testing.
EXPO_PUBLIC_ENABLE_CALIBRATION=0

# Reserved for future persistent-anchor provider after field validation.
EXPO_PUBLIC_SPATIAL_ANCHOR_PROVIDER=none
