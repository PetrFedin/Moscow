# Client-side MapKit key. Restrict it in Yandex Developer Dashboard by app identifiers/signatures.
EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY=

# First verified Romanov Chambers GLB. Can point to a CDN during development.
EXPO_PUBLIC_ROMANOV_GLB_URL=

# Show field calibration controls in non-development builds used for on-site testing.
EXPO_PUBLIC_ENABLE_CALIBRATION=0

# Persistent anchor provider is a separate native-build concern from Yandex MapKit.
# Allowed values: none | reactvision | arcore
EXPO_PUBLIC_SPATIAL_ANCHOR_PROVIDER=none

# Required only when EXPO_PUBLIC_SPATIAL_ANCHOR_PROVIDER=reactvision.
# Supply through the native build/deployment secret store; do not commit real values.
VIRO_RV_API_KEY=
VIRO_RV_PROJECT_ID=
# Optional custom endpoint for staging/testing only.
VIRO_RV_ENDPOINT=

# Required only when EXPO_PUBLIC_SPATIAL_ANCHOR_PROVIDER=arcore.
# Supply through the native build/deployment secret store; do not commit the real value.
VIRO_GOOGLE_CLOUD_API_KEY=

# Optional build identifier written into field-verification sessions.
EXPO_PUBLIC_BUILD_ID=
